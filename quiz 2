from datetime import datetime

# i) Input from the user
bookID = input("Enter Book ID: ")
dueDate_input = input("Enter Due Date (YYYY-MM-DD): ")
returnDate_input = input("Enter Return Date (YYYY-MM-DD): ")

# Convert the dates to datetime objects
dueDate = datetime.strptime(dueDate_input, "%Y-%m-%d")
returnDate = datetime.strptime(returnDate_input, "%Y-%m-%d")

# ii) Calculate days overdue
daysOverdue = (returnDate - dueDate).days

# Ensure no negative days
if daysOverdue < 0:
    daysOverdue = 0

# iii) Determine fine rate and calculate fine amount
if daysOverdue <= 7:
    fineRate = 20
elif 8 <= daysOverdue <= 14:
    fineRate = 50
else:
    fineRate = 100

fineAmount = daysOverdue * fineRate

# iv) Display the results
print("\n--- Library Fine Details ---")
print("Book ID:", bookID)
print("Due Date:", dueDate_input)
print("Return Date:", returnDate_input)
print("Days Overdue:", daysOverdue)
print("Fine Rate per Day: Ksh.", fineRate)
print("Total Fine Amount: Ksh.", fineAmount)
