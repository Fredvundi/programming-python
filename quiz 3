# Prompt the user to enter names separated by commas
names_input = input("Enter a list of names separated by commas: ")

# Split the input into a list, remove leading/trailing spaces
names_list = [name.strip() for name in names_input.split(",")]

# Count total number of names entered (including duplicates)
total_names = len(names_list)

# Remove duplicates using a set, then sort alphabetically
unique_sorted_names = sorted(set(names_list))

# Display results
print("\nFinal sorted list (duplicates removed):")
for name in unique_sorted_names:
    print(name)

print(f"\nTotal number of names entered: {total_names}")
