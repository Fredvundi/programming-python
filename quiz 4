inventory = {}

while True:
    print("\nInventory Menu:")
    print("1. Add or Update an Item")
    print("2. Retrieve an Item")
    print("3. Display Total Quantity")
    print("4. Exit")

    choice = input("Enter your choice (1-4): ")

    if choice == "1":
        item = input("Enter item name: ").lower()
        qty = int(input("Enter quantity: "))

        if item in inventory:
            inventory[item] += qty
            print(f"Updated '{item}' quantity to {inventory[item]}")
        else:
            inventory[item] = qty
            print(f"Added '{item}' with quantity {qty}")

    elif choice == "2":
        item = input("Enter item name to search: ").lower()
        if item in inventory:
            print(f"Item: {item}, Quantity: {inventory[item]}")
        else:
            print(f"'{item}' not found in inventory")

    elif choice == "3":
        total_qty = sum(inventory.values())
        print(f"Total quantity of all items: {total_qty}")

    elif choice == "4":
        print("Exiting program... Goodbye!")
        break

    else:
        print("Invalid choice. Please enter a number from 1 to 4.")
